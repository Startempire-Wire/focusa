{
  "schema": "focusa.release_topology.v1",
  "project_id": "focusa",
  "profile": "multi_surface_cross_platform",
  "provider": "github_actions",
  "provider_contract": {
    "schema": "focusa.release_provider_contract.v1",
    "primary": "github_actions",
    "emergency": [
      {
        "provider": "appveyor",
        "project": "verioussmith/focusa",
        "repository": "Startempire-Wire/focusa",
        "activation_requires": [
          "operator_directive",
          "provider_incident_ref",
          "exact_tag_commit_match"
        ],
        "required_gate_receipts": [
          "release-contract",
          "source-ci",
          "strict-spec-gates",
          "terminal-windows",
          "terminal-linux",
          "terminal-macos",
          "rust-macos",
          "rust-linux",
          "rust-windows",
          "desktop-macos",
          "desktop-windows",
          "portable-surfaces",
          "trust-and-publication",
          "ota-deploy-live"
        ],
        "signing": {
          "cosign_oidc_issuer": "https://accounts.google.com",
          "cosign_audience": "sigstore",
          "rekor_required": true,
          "ed25519_required": true
        },
        "publication": {
          "draft_until_all_gates_green": true,
          "canonical_asset_verifier": "scripts/verify-canonical-release-assets.py",
          "latest_requires_live_proof": true
        }
      }
    ]
  },
  "global_gates": [
    "project_identity_verified",
    "release_scope_locked",
    "release_candidate_sha_exact",
    "open_release_gate_issues_zero",
    "open_pull_requests_zero",
    "version_surfaces_consistent",
    "final_release_gap_gate",
    "signed_manifest_and_provenance"
  ],
  "surfaces": [
    {
      "surface_id": "core",
      "kind": "library",
      "depends_on": [],
      "required_gates": ["workspace_tests", "clippy_warnings_denied", "spec_gates_strict"],
      "artifact_identity": "source_sha+Cargo.lock+toolchain",
      "deployment_target": null,
      "canary_required": false,
      "rollback_required": false
    },
    {
      "surface_id": "cli",
      "kind": "cli",
      "depends_on": ["core"],
      "required_gates": ["linux_gnu", "linux_musl", "macos_arm64", "macos_x64", "windows_x64", "ota_apply_contract"],
      "artifact_identity": "sha256+detached_signature",
      "deployment_target": null,
      "canary_required": false,
      "rollback_required": false
    },
    {
      "surface_id": "daemon",
      "kind": "daemon",
      "depends_on": ["core"],
      "required_gates": ["linux_gnu", "linux_musl", "macos_arm64", "macos_x64", "windows_x64", "retained_state_boot", "health_version_contract"],
      "artifact_identity": "sha256+detached_signature+deploy_proof",
      "deployment_target": "production_daemon",
      "canary_required": true,
      "rollback_required": true
    },
    {
      "surface_id": "tui",
      "kind": "tui",
      "depends_on": ["core", "cli"],
      "required_gates": ["spec132_conpty", "spec132_unix_terminal", "cross_target_builds"],
      "artifact_identity": "sha256+detached_signature",
      "deployment_target": null,
      "canary_required": false,
      "rollback_required": false
    },
    {
      "surface_id": "pi_extension",
      "kind": "agent_extension",
      "depends_on": ["core"],
      "required_gates": ["npm_locked_install", "typescript", "eslint", "runtime_tests", "ota_activation_receipt"],
      "artifact_identity": "sha256+detached_signature+package_version",
      "deployment_target": "pi_extension_directory",
      "canary_required": false,
      "rollback_required": true
    },
    {
      "surface_id": "menubar",
      "kind": "desktop",
      "depends_on": ["daemon", "core"],
      "required_gates": ["tauri_build", "updater_signature", "macos_bundle_validation", "relaunch_proof"],
      "artifact_identity": "sha256+tauri_signature",
      "deployment_target": "tauri_updater",
      "canary_required": false,
      "rollback_required": true
    },
    {
      "surface_id": "installer",
      "kind": "installer",
      "depends_on": ["cli", "daemon", "tui", "pi_extension"],
      "required_gates": ["complete_asset_resolution", "checksum_refusal", "archive_path_safety", "install_upgrade_rollback"],
      "artifact_identity": "sha256+detached_signature",
      "deployment_target": "install_bootstrapper",
      "canary_required": false,
      "rollback_required": true
    },
    {
      "surface_id": "agent_context",
      "kind": "documentation",
      "depends_on": ["pi_extension"],
      "required_gates": ["skill_inventory", "link_integrity", "archive_path_safety"],
      "artifact_identity": "sha256+detached_signature",
      "deployment_target": "agent_context_directory",
      "canary_required": false,
      "rollback_required": true
    }
  ]
}
