{
  "schema": "focusa.release_adapter_manifest.v1",
  "manifest_id": "uiai-engine-v1",
  "topology_ref": "config/release-topologies/uiai-engine.json",
  "descriptor": {
    "schema": "focusa.release_adapter.v1",
    "adapter_id": "uiai-engine",
    "adapter_version": "1",
    "supported_profiles": ["service_container_web"],
    "supported_surface_kinds": ["service", "container", "library"],
    "supported_stages": ["locked", "candidate_snapshotted", "preflighted", "built", "packaged", "provenanced", "draft_published", "canary_deployed", "verified", "promoted", "closed", "rolled_back"],
    "supports_canary": true,
    "supports_rollback": true
  },
  "operations": [
    {"operation_id":"scope-lock","stage":"locked","executor_id":"uiai-engine","kind":"tool_call","action":"release.lock","mutates":false,"timeout_seconds":60},
    {"operation_id":"candidate-snapshot","stage":"candidate_snapshotted","executor_id":"uiai-engine","kind":"tool_call","action":"release.snapshot","mutates":true,"timeout_seconds":120},
    {"operation_id":"engine-conformance","stage":"preflighted","executor_id":"uiai-engine","kind":"tool_call","action":"release.preflight_protocol_and_diagnostics","mutates":false,"timeout_seconds":1800},
    {"operation_id":"build-engine","stage":"built","executor_id":"uiai-engine","kind":"tool_call","action":"release.build_exact_sha","mutates":true,"timeout_seconds":1800},
    {"operation_id":"package-engine","stage":"packaged","executor_id":"uiai-engine","kind":"tool_call","action":"release.package_service_and_runtime","mutates":true,"timeout_seconds":900},
    {"operation_id":"provenance","stage":"provenanced","executor_id":"uiai-engine","kind":"tool_call","action":"release.provenance","mutates":true,"timeout_seconds":600},
    {"operation_id":"draft","stage":"draft_published","executor_id":"uiai-engine","kind":"tool_call","action":"release.publish_draft","mutates":true,"timeout_seconds":300},
    {"operation_id":"canary","stage":"canary_deployed","executor_id":"uiai-engine","kind":"tool_call","action":"release.deploy_canary","surface_ids":["engine_api","browser_runtime"],"mutates":true,"timeout_seconds":600},
    {"operation_id":"visual-health","stage":"verified","executor_id":"uiai-engine","kind":"tool_call","action":"release.verify_health_diagnostics_visual_smoke","mutates":false,"timeout_seconds":600},
    {"operation_id":"promote","stage":"promoted","executor_id":"uiai-engine","kind":"tool_call","action":"release.promote_canary","mutates":true,"timeout_seconds":600},
    {"operation_id":"settle","stage":"closed","executor_id":"uiai-engine","kind":"tool_call","action":"release.settle_and_learn","mutates":true,"timeout_seconds":300},
    {"operation_id":"rollback","stage":"rolled_back","executor_id":"uiai-engine","kind":"tool_call","action":"release.rollback_verified_prior_runtime","mutates":true,"timeout_seconds":600}
  ]
}
