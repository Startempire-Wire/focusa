{
  "name": "focusa-pi-bridge",
  "version": "0.9.121-dev",
  "private": true,
  "description": "Focusa cognitive integration extension for Pi coding agent",
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --pretty false",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test:spec104": "node tests/spec104-pi-runtime-isolation.test.mjs",
    "test:spec130-rollover": "node tests/spec130-rollover-command-lifecycle.test.mjs",
    "test:spec104-attachment": "node tests/spec104-attachment-runtime-isolation.test.mjs",
    "test:cache-safe-context": "node tests/cache-safe-context.test.mjs",
    "test:ota-activation": "node tests/ota-activation.test.mjs",
    "test:work-rail-width": "node tests/work-rail-widget-width.test.mjs"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0"
  },
  "overrides": {
    "protobufjs": "7.6.3",
    "undici": "7.28.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@earendil-works/pi-tui": "0.81.1",
    "@types/node": "25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.4",
    "typescript": "^5.0.0"
  }
}
