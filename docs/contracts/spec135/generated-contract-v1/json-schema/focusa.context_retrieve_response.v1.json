                "type": "array"
              },
              "status": {
                "const": "candidate"
              },
              "summary": {
                "type": "string"
              }
            },
            "required": [
              "contradiction_id",
              "status",
              "summary",
              "left_citation_id",
              "right_citation_id",
              "shared_terms"
            ],
            "type": "object"
          },
          "maxItems": 1225,
          "type": "array"
        },
        "hits": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "chunk_id": {
                "type": "string"
              },
              "citation": {
                "additionalProperties": false,
                "properties": {
                  "chunk_id": {
                    "type": "string"
                  },
                  "chunk_ordinal": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "citation_id": {
                    "type": "string"
                  },
                  "content_hash": {
                    "type": "string"
                  },
                  "line_end": {
                    "minimum": 1,
