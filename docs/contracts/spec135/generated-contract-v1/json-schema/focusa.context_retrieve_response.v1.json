    "canonical_sources",
    "result",
    "evidence_ref",
    "receipt_ref",
    "tool_result"
  ],
  "title": "focusa.context_retrieve_response.v1",
  "type": "object",
  "x-focusa-generated-from": "ContextRetrieveResponse",
  "x-focusa-schema-id": "focusa.context_retrieve_response.v1"
}
