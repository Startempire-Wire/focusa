      "type": "string"
    },
    "receipt_ref": {
      "type": "string"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "additionalProperties": false,
          "properties": {
            "degradation_reason": {
              "maxLength": 320,
              "type": "string"
            },
            "degraded_to_lexical": {
              "type": "boolean"
            },
            "embedding_model": {
              "type": "string"
            },
            "embedding_provider": {
              "type": "string"
            },
            "lexical": {
              "type": "string"
            },
            "vector_index": {
              "type": "string"
            }
          },
          "required": [
