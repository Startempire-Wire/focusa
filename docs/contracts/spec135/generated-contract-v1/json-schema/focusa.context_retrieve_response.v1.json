                  "chunk_ordinal",
                  "line_start",
                  "line_end"
                ],
                "type": "object"
              },
              "contradiction_refs": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "retrieval_modes": {
                "items": {
                  "enum": [
                    "lexical",
                    "vector"
                  ]
                },
                "type": "array",
                "uniqueItems": true
              },
              "score": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "snippet": {
                "maxLength": 1600,
                "type": "string"
              }
            },
            "required": [
              "chunk_id",
              "snippet",
              "score",
              "retrieval_modes",
              "citation",
              "contradiction_refs"
            ],
            "type": "object"
          },
          "maxItems": 50,
          "type": "array"
        },
        "indexed_chunk_count": {
          "minimum": 0,
          "type": "integer"
        },
        "indexed_source_count": {
          "minimum": 0,
          "type": "integer"
        },
        "mode_requested": {
          "enum": [
            "lexical",
            "hybrid"
          ]
        },
        "mode_used": {
          "enum": [
            "lexical",
            "hybrid"
          ]
        },
        "query": {
          "type": "string"
        },
        "result_count": {
          "maximum": 50,
          "minimum": 0,
          "type": "integer"
        },
        "schema": {
