{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.startempire.ai/focusa/spec135/focusa.workspace_event.v1.json",
  "title": "Focusa Workspace Invalidation Event v1",
  "type": "object",
  "required": [
    "schema",
    "event",
    "event_id",
    "cursor",
    "project_root",
    "continuity_id",
    "session_id",
    "attachment_id",
    "invalidate"
  ],
  "properties": {
    "schema": {
      "const": "focusa.workspace_event.v1"
    },
    "event": {
      "type": "string",
      "enum": [
        "workspace_artifact_added",
        "uiai_session_opened",
        "uiai_session_status_changed",
        "uiai_fpv_share_created",
        "browser_context_created",
        "browser_context_status_changed",
        "browser_context_closed",
        "browser_target_opened",
        "browser_target_navigated",
        "browser_target_moved",
        "browser_target_closed",
        "workspace_artifact_capture_pending",
        "workspace_artifact_linked",
        "workspace_artifact_verified",
        "workspace_artifact_stale",
        "workspace_artifact_redacted",
        "workspace_artifact_removed",
        "workspace_artifact_render_failed"
      ]
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "cursor": {
      "type": "string",
      "minLength": 1
    },
    "project_root": {
      "type": "string",
      "minLength": 1
    },
    "continuity_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "attachment_id": {
      "type": "string",
      "minLength": 1
    },
    "work_surface_id": {
      "type": "string"
    },
    "artifact_id": {
      "type": "string"
    },
    "invalidate": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(mission_canvas|workspace|workpoint|context|connectors)\\."
      }
    }
  },
  "additionalProperties": false
}
