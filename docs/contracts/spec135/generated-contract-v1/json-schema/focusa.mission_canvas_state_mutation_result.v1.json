{
  "$id": "/v1/agent/schemas/focusa.mission_canvas_state_mutation_result.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "focusa.mission_canvas_state_mutation_result.v1",
  "type": "object",
  "additionalProperties": false,
  "x-focusa-schema-id": "focusa.mission_canvas_state_mutation_result.v1",
  "properties": {
    "schema": {
      "const": "focusa.mission_canvas_state_mutation_result.v1"
    },
    "state_version": {
      "type": "integer",
      "minimum": 0
    },
    "replayed": {
      "type": "boolean"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canvas_id": {
          "type": "string"
        },
        "state_revision": {
          "type": "integer",
          "minimum": 1
        },
        "project_root": {
          "type": "string"
        },
        "continuity_id": {
          "type": "string"
        },
        "client_instance_id": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        },
        "device_id": {
          "type": "string"
        },
        "open_work_surface_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "focused_work_surface_id": {
          "type": "string"
        },
        "secondary_focused_surface_id": {
          "type": "string"
        },
        "split_layout_ref": {
          "type": "string"
        },
        "group_order": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "aggregate_project_roots": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "aggregate_continuity_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "aggregate_surface_kinds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "aggregate_surface_states": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "selected_context_refs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "unread_event_cursor": {
          "type": "integer",
          "minimum": 0
        },
        "session_projection_revision": {
          "type": "integer",
          "minimum": 0
        },
        "idempotency_key": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "canvas_id",
        "state_revision",
        "project_root",
        "continuity_id",
        "client_instance_id",
        "user_id",
        "device_id",
        "open_work_surface_ids",
        "group_order",
        "aggregate_project_roots",
        "aggregate_continuity_ids",
        "aggregate_surface_kinds",
        "aggregate_surface_states",
        "selected_context_refs",
        "session_projection_revision",
        "idempotency_key",
        "created_at",
        "updated_at"
      ]
    },
    "evidence_ref": {
      "type": "string"
    },
    "receipt_ref": {
      "type": "string"
    },
    "tool_result": {
      "$ref": "focusa.tool_result.v1.json"
    }
  },
  "required": [
    "schema",
    "state_version",
    "replayed",
    "canvas",
    "evidence_ref",
    "receipt_ref",
    "tool_result"
  ]
}
