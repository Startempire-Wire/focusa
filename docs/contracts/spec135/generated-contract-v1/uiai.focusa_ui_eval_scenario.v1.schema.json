{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusa.dev/contracts/uiai.focusa_ui_eval_scenario.v1.schema.json",
  "title": "UIAI Focusa generated-UI Eval scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scenario_id", "feature_scope", "route_or_target", "preconditions", "steps", "required_capabilities", "required_scopes", "expected_visible_states", "expected_actions", "expected_evidence", "expected_receipts"],
  "properties": {
    "schema": {"const": "uiai.focusa_ui_eval_scenario.v1"},
    "scenario_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "feature_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_root", "continuity_id", "attachment_id"],
      "properties": {
        "project_root": {"type": "string", "minLength": 1},
        "continuity_id": {"type": "string", "minLength": 1},
        "attachment_id": {"type": "string", "minLength": 1}
      }
    },
    "route_or_target": {"type": "string", "minLength": 1},
    "preconditions": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "action", "target", "expected"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1, "maxLength": 80},
          "action": {"enum": ["open", "read", "snapshot", "click", "fill", "press", "resize", "diagnostics", "close"]},
          "target": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1},
          "evidence_kind": {"enum": ["dom", "screenshot", "diagnostics", "accessibility", "visual", "action"]}
        }
      }
    },
    "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_scopes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "expected_visible_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "expected_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "expected_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "expected_receipts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
