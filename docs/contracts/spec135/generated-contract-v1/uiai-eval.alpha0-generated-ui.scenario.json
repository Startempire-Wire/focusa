{
  "schema": "uiai.focusa_ui_eval_scenario.v1",
  "scenario_id": "spec135-alpha0-generated-ui-action-recovery",
  "feature_scope": {
    "project_root": "/example/focusa",
    "continuity_id": "focusa-cont-alpha0-eval",
    "attachment_id": "attachment:context-alpha0"
  },
  "route_or_target": "packages/a2ui-renderer/proof/index.html",
  "preconditions": [
    "A2UI v0.9.1 web_core and permanent Lit renderer are built",
    "The trusted Focusa catalog registers 31 Svelte Custom Elements",
    "Only context.review is allowlisted for the scenario"
  ],
  "steps": [
    {"step_id": "open", "action": "open", "target": "generated UI proof target", "expected": "Alpha 0 generated surface renders", "evidence_kind": "dom"},
    {"step_id": "render", "action": "snapshot", "target": "Focusa generated surface", "expected": "Stage, two actions, and explicit unsupported-component recovery are visible", "evidence_kind": "accessibility"},
    {"step_id": "allowlisted-action", "action": "click", "target": "Review sources", "expected": "context.review executes with exact project/workstream/attachment scope", "evidence_kind": "action"},
    {"step_id": "blocked-action", "action": "click", "target": "Test recovery", "expected": "unknown.mutate does not execute and an Unsupported action recovery card appears", "evidence_kind": "dom"},
    {"step_id": "responsive", "action": "resize", "target": "390x844", "expected": "Primary actions remain visible and keyboard-operable", "evidence_kind": "screenshot"},
    {"step_id": "keyboard", "action": "press", "target": "Tab", "expected": "Focus reaches an actionable generated control", "evidence_kind": "accessibility"},
    {"step_id": "diagnostics", "action": "diagnostics", "target": "UIAI browser session", "expected": "No console exception or failed network request", "evidence_kind": "diagnostics"},
    {"step_id": "close", "action": "close", "target": "UIAI browser session", "expected": "Session resources are released", "evidence_kind": "diagnostics"}
  ],
  "required_capabilities": ["a2ui-web_core-0.9.1", "a2ui-lit-0.9.1", "focusa-svelte-elements-0.9.120-dev", "uiai-browser-diagnostics"],
  "required_scopes": ["project_root", "continuity_id", "attachment_id"],
  "expected_visible_states": ["saved", "unsupported component recovery", "unsupported action recovery", "mobile"],
  "expected_actions": ["context.review allowed", "unknown.mutate blocked"],
  "expected_evidence": ["accessibility snapshot", "desktop screenshot", "mobile screenshot", "bounded diagnostics"],
  "expected_receipts": []
}
