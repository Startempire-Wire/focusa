{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusa.dev/contracts/uiai.focusa_ui_eval_result.v1.schema.json",
  "title": "UIAI Focusa generated-UI Eval result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scenario_id", "status", "browser_session_refs", "browser_context_refs", "step_results", "screenshots", "diagnostics", "visual_comparison_refs", "focusa_evidence_refs", "receipt_refs", "evaluated_at"],
  "properties": {
    "schema": {"const": "uiai.focusa_ui_eval_result.v1"},
    "scenario_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "status": {"enum": ["passed", "failed", "blocked"]},
    "browser_session_refs": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1}},
    "browser_context_refs": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1}},
    "step_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "status", "result", "evidence_refs"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed", "blocked", "skipped"]},
          "result": {"type": "string", "minLength": 1, "maxLength": 500},
          "evidence_refs": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "screenshots": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1}},
    "diagnostics": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "category", "summary"],
        "properties": {
          "level": {"enum": ["info", "warning", "error"]},
          "category": {"enum": ["console", "exception", "network", "accessibility", "visual", "runtime"]},
          "summary": {"type": "string", "minLength": 1, "maxLength": 500},
          "diagnostics_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "accessibility_report_ref": {"type": ["string", "null"]},
    "visual_comparison_refs": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1}},
    "focusa_evidence_refs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1}},
    "receipt_refs": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1}},
    "failure_class": {"type": ["string", "null"]},
    "recovery_action": {"type": ["string", "null"]},
    "evaluated_at": {"type": "string", "format": "date-time"}
  }
}
