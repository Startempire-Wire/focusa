{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusa.dev/contracts/spec152-capsule-manifest.v1.schema.json",
  "title": "Focusa Spec 152/152A Signed Capsule Manifest",
  "description": "Public-safe schema for a versioned signed capsule manifest. The manifest binds capsule identity, version, platform/architecture compatibility, plaintext and ciphertext digests, the minimum compatible public-shell contract, required lease features and limit policy version, release channel and status, revocation state, provenance, and the node-bound key envelope reference. Digest and signature authority live ONLY inside this signed manifest: an unsigned sidecar checksum carries no authority and there is no global key.",
  "$defs": {
    "sha256Digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "publicShellContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "major", "minor"],
      "properties": {
        "id": { "const": "focusa.public_shell" },
        "major": { "type": "integer", "minimum": 1 },
        "minor": { "type": "integer", "minimum": 0 }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revoked", "revocation_id", "revoked_at", "reason"],
      "properties": {
        "revoked": { "type": "boolean" },
        "revocation_id": {
          "oneOf": [
            { "type": "string", "pattern": "^revoc_[A-Za-z0-9_-]{8,64}$" },
            { "type": "null" }
          ]
        },
        "revoked_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "reason": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 240 },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "revoked": { "const": true } } },
          "then": {
            "properties": {
              "revocation_id": { "type": "string" },
              "revoked_at": { "type": "string" },
              "reason": { "type": "string" }
            }
          },
          "else": {
            "properties": {
              "revocation_id": { "type": "null" },
              "revoked_at": { "type": "null" },
              "reason": { "type": "null" }
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["builder_id", "build_id", "source_commit", "signed_at"],
      "properties": {
        "builder_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" },
        "build_id": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,160}$" },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "signed_at": { "type": "string", "format": "date-time" }
      }
    },
    "keyEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "envelope_ref", "envelope_digest_sha256"],
      "properties": {
        "schema": { "const": "focusa.node_capsule_key_envelope.v1" },
        "envelope_ref": { "type": "string", "pattern": "^envelope_[A-Za-z0-9_-]{16,64}$" },
        "envelope_digest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signature_algorithm", "signer_key_id", "signature_b64"],
      "properties": {
        "signature_algorithm": { "const": "ed25519" },
        "signer_key_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$" },
        "signature_b64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
          "minLength": 88
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_version",
    "capsule_id",
    "capsule_version",
    "product",
    "feature_namespace",
    "platform",
    "arch",
    "digests",
    "public_shell_contract",
    "required_features",
    "limit_policy_version",
    "channel",
    "release_status",
    "revocation",
    "provenance",
    "key_envelope",
    "signature"
  ],
  "properties": {
    "schema": { "const": "focusa.capsule_manifest.v1" },
    "manifest_version": { "const": 1 },
    "capsule_id": { "type": "string", "pattern": "^capsule_[A-Za-z0-9_-]{16,64}$" },
    "capsule_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "product": { "enum": ["focusa", "uiai_engine"] },
    "feature_namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
    },
    "platform": { "enum": ["linux", "macos", "windows"] },
    "arch": { "enum": ["x86_64", "aarch64"] },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plaintext", "ciphertext"],
      "properties": {
        "plaintext": { "$ref": "#/$defs/sha256Digest" },
        "ciphertext": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "public_shell_contract": { "$ref": "#/$defs/publicShellContract" },
    "required_features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$"
      }
    },
    "limit_policy_version": {
      "type": "string",
      "pattern": "^focusa\\.[a-z0-9_]+(\\.[a-z0-9_]+)*\\.v[0-9]+$"
    },
    "channel": { "enum": ["stable", "preview", "beta", "internal"] },
    "release_status": { "enum": ["released", "deprecated", "withdrawn"] },
    "revocation": { "$ref": "#/$defs/revocation" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "key_envelope": { "$ref": "#/$defs/keyEnvelope" },
    "signature": { "$ref": "#/$defs/signature" }
  }
}
