{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://focusa.dev/schemas/spec149-event-payloads.v1.json",
  "title": "Focusa Spec149 Workset Event Payloads v1",
  "$defs": {
    "StableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "Ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "Refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "uniqueItems": true
    },
    "Sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "CreatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_ref",
        "cardinality_mode",
        "admission_state",
        "lifecycle_state"
      ],
      "properties": {
        "definition_ref": {
          "$ref": "#/$defs/Ref"
        },
        "cardinality_mode": {
          "enum": [
            "fixed",
            "rolling",
            "provider_stream"
          ]
        },
        "admission_state": {
          "const": "draft"
        },
        "lifecycle_state": {
          "const": "planned"
        }
      }
    },
    "DefinitionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_revision",
        "new_revision",
        "change_refs"
      ],
      "properties": {
        "prior_revision": {
          "type": "integer",
          "minimum": 1
        },
        "new_revision": {
          "type": "integer",
          "minimum": 2
        },
        "change_refs": {
          "$ref": "#/$defs/Refs"
        },
        "impact_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        }
      }
    },
    "ProviderPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_ref",
        "provider_revision_ref",
        "freshness"
      ],
      "properties": {
        "binding_ref": {
          "$ref": "#/$defs/StableId"
        },
        "provider_revision_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "unavailable"
          ]
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "lag_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      }
    },
    "TombstonePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_ref",
        "work_item_ref",
        "provider_revision_ref",
        "tombstone_kind"
      ],
      "properties": {
        "binding_ref": {
          "$ref": "#/$defs/StableId"
        },
        "work_item_ref": {
          "$ref": "#/$defs/Ref"
        },
        "provider_revision_ref": {
          "$ref": "#/$defs/Ref"
        },
        "tombstone_kind": {
          "enum": [
            "deleted",
            "renamed",
            "transferred",
            "missing"
          ]
        },
        "replacement_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        }
      }
    },
    "AdmissionPreviewPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preview_id",
        "candidate_count",
        "candidate_digest",
        "impact_ref",
        "expires_at"
      ],
      "properties": {
        "preview_id": {
          "$ref": "#/$defs/StableId"
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_digest": {
          "$ref": "#/$defs/Sha256"
        },
        "impact_ref": {
          "$ref": "#/$defs/Ref"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "warning_codes": {
          "$ref": "#/$defs/Refs"
        }
      }
    },
    "AdmissionResultPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preview_id",
        "candidate_digest",
        "member_refs",
        "result"
      ],
      "properties": {
        "preview_id": {
          "$ref": "#/$defs/StableId"
        },
        "candidate_digest": {
          "$ref": "#/$defs/Sha256"
        },
        "member_refs": {
          "$ref": "#/$defs/Refs"
        },
        "result": {
          "enum": [
            "admitted",
            "rejected"
          ]
        },
        "reason_codes": {
          "$ref": "#/$defs/Refs"
        }
      }
    },
    "MemberPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_ref",
        "work_item_ref",
        "disposition",
        "freshness"
      ],
      "properties": {
        "member_ref": {
          "$ref": "#/$defs/StableId"
        },
        "work_item_ref": {
          "$ref": "#/$defs/Ref"
        },
        "provider_revision_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "disposition": {
          "enum": [
            "pending",
            "completed",
            "excluded",
            "superseded",
            "cancelled",
            "blocked"
          ]
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "unavailable",
            "unknown"
          ]
        },
        "supersedes_member_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      }
    },
    "RelationshipPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship_ref",
        "source_workset_ref",
        "target_workset_ref",
        "relationship",
        "membership_policy"
      ],
      "properties": {
        "relationship_ref": {
          "$ref": "#/$defs/StableId"
        },
        "source_workset_ref": {
          "$ref": "#/$defs/StableId"
        },
        "target_workset_ref": {
          "$ref": "#/$defs/StableId"
        },
        "relationship": {
          "enum": [
            "parent",
            "child",
            "successor",
            "recurring_template",
            "imports_evidence_from"
          ]
        },
        "membership_policy": {
          "enum": [
            "exclusive",
            "shared_read",
            "shared_closure"
          ]
        }
      }
    },
    "ExternalDependencyPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_dependency_ref",
        "work_item_ref",
        "required_by_member_refs",
        "policy",
        "result"
      ],
      "properties": {
        "external_dependency_ref": {
          "$ref": "#/$defs/StableId"
        },
        "work_item_ref": {
          "$ref": "#/$defs/Ref"
        },
        "required_by_member_refs": {
          "$ref": "#/$defs/Refs"
        },
        "policy": {
          "enum": [
            "observe",
            "block",
            "admit_by_preview",
            "evidence_only"
          ]
        },
        "result": {
          "enum": [
            "added",
            "resolved",
            "unresolved"
          ]
        }
      }
    },
    "EdgePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_ref",
        "from_member_ref",
        "to_member_ref",
        "edge_type",
        "result"
      ],
      "properties": {
        "edge_ref": {
          "$ref": "#/$defs/StableId"
        },
        "from_member_ref": {
          "$ref": "#/$defs/StableId"
        },
        "to_member_ref": {
          "$ref": "#/$defs/StableId"
        },
        "edge_type": {
          "enum": [
            "blocks",
            "parent_child",
            "evidence_requires",
            "checkpoint_requires",
            "release_requires"
          ]
        },
        "result": {
          "enum": [
            "added",
            "removed"
          ]
        }
      }
    },
    "EpochPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch_ref",
        "ordinal",
        "state",
        "membership_digest"
      ],
      "properties": {
        "epoch_ref": {
          "$ref": "#/$defs/StableId"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": [
            "open",
            "sealing",
            "sealed",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "cursor_start": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "cursor_end": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "membership_digest": {
          "$ref": "#/$defs/Sha256"
        },
        "graph_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "SealPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_ref",
        "result",
        "membership_digest",
        "graph_digest",
        "provider_snapshot_refs"
      ],
      "properties": {
        "target_ref": {
          "$ref": "#/$defs/StableId"
        },
        "result": {
          "enum": [
            "sealing",
            "sealed",
            "reopened"
          ]
        },
        "membership_digest": {
          "$ref": "#/$defs/Sha256"
        },
        "graph_digest": {
          "$ref": "#/$defs/Sha256"
        },
        "provider_snapshot_refs": {
          "$ref": "#/$defs/Refs"
        },
        "invalidated_candidate_refs": {
          "$ref": "#/$defs/Refs"
        }
      }
    },
    "CheckpointPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow_ref",
        "flow_revision",
        "run_ref",
        "proof_identity",
        "result"
      ],
      "properties": {
        "flow_ref": {
          "$ref": "#/$defs/StableId"
        },
        "flow_revision": {
          "type": "integer",
          "minimum": 1
        },
        "run_ref": {
          "$ref": "#/$defs/StableId"
        },
        "proof_identity": {
          "$ref": "#/$defs/Sha256"
        },
        "result": {
          "enum": [
            "defined",
            "started",
            "passed",
            "failed",
            "indeterminate"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/Refs"
        },
        "receipt_refs": {
          "$ref": "#/$defs/Refs"
        },
        "reason_codes": {
          "$ref": "#/$defs/Refs"
        }
      }
    },
    "WorkpointProposalPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_ref",
        "target_ref",
        "ready_reason_refs",
        "advisory"
      ],
      "properties": {
        "candidate_ref": {
          "$ref": "#/$defs/StableId"
        },
        "target_ref": {
          "$ref": "#/$defs/Ref"
        },
        "ready_reason_refs": {
          "$ref": "#/$defs/Refs"
        },
        "advisory": {
          "const": true
        }
      }
    },
    "CompletionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completion_ref",
        "contract_revision",
        "result",
        "blocking_refs"
      ],
      "properties": {
        "completion_ref": {
          "$ref": "#/$defs/StableId"
        },
        "contract_revision": {
          "type": "integer",
          "minimum": 1
        },
        "result": {
          "enum": [
            "preflighted",
            "blocked",
            "started",
            "completed",
            "failed"
          ]
        },
        "blocking_refs": {
          "$ref": "#/$defs/Refs"
        },
        "transition_refs": {
          "$ref": "#/$defs/Refs"
        }
      }
    },
    "TransitionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_ref",
        "transition_revision",
        "exactly_once_identity",
        "result"
      ],
      "properties": {
        "transition_ref": {
          "$ref": "#/$defs/StableId"
        },
        "transition_revision": {
          "type": "integer",
          "minimum": 1
        },
        "exactly_once_identity": {
          "$ref": "#/$defs/StableId"
        },
        "result": {
          "enum": [
            "started",
            "succeeded",
            "failed",
            "compensated"
          ]
        },
        "operation_receipt_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "compensation_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        }
      }
    },
    "ReleasePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_binding_ref",
        "sealed_revision",
        "membership_digest",
        "graph_digest",
        "exact_sha",
        "release_cycle_ref"
      ],
      "properties": {
        "release_binding_ref": {
          "$ref": "#/$defs/StableId"
        },
        "sealed_revision": {
          "type": "integer",
          "minimum": 1
        },
        "membership_digest": {
          "$ref": "#/$defs/Sha256"
        },
        "graph_digest": {
          "$ref": "#/$defs/Sha256"
        },
        "exact_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "release_cycle_ref": {
          "$ref": "#/$defs/Ref"
        },
        "release_journal_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        }
      }
    },
    "LifecyclePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_state",
        "new_state",
        "reason_code"
      ],
      "properties": {
        "prior_state": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "new_state": {
          "enum": [
            "planned",
            "running",
            "paused",
            "blocked",
            "completing",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "reason_code": {
          "$ref": "#/$defs/StableId"
        },
        "recovery_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        }
      }
    },
    "RepairPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repair_ref",
        "superseded_event_refs",
        "correction_refs",
        "reason_code"
      ],
      "properties": {
        "repair_ref": {
          "$ref": "#/$defs/StableId"
        },
        "superseded_event_refs": {
          "$ref": "#/$defs/Refs"
        },
        "correction_refs": {
          "$ref": "#/$defs/Refs"
        },
        "reason_code": {
          "$ref": "#/$defs/StableId"
        }
      }
    },
    "EventVariant": {
      "oneOf": [
        {
          "$ref": "#/$defs/CreatedEvent"
        },
        {
          "$ref": "#/$defs/DefinitionEvent"
        },
        {
          "$ref": "#/$defs/ProviderEvent"
        },
        {
          "$ref": "#/$defs/TombstoneEvent"
        },
        {
          "$ref": "#/$defs/AdmissionPreviewEvent"
        },
        {
          "$ref": "#/$defs/AdmissionResultEvent"
        },
        {
          "$ref": "#/$defs/MemberEvent"
        },
        {
          "$ref": "#/$defs/RelationshipEvent"
        },
        {
          "$ref": "#/$defs/ExternalDependencyEvent"
        },
        {
          "$ref": "#/$defs/EdgeEvent"
        },
        {
          "$ref": "#/$defs/EpochEvent"
        },
        {
          "$ref": "#/$defs/SealEvent"
        },
        {
          "$ref": "#/$defs/CheckpointEvent"
        },
        {
          "$ref": "#/$defs/WorkpointProposalEvent"
        },
        {
          "$ref": "#/$defs/CompletionEvent"
        },
        {
          "$ref": "#/$defs/TransitionEvent"
        },
        {
          "$ref": "#/$defs/ReleaseEvent"
        },
        {
          "$ref": "#/$defs/LifecycleEvent"
        },
        {
          "$ref": "#/$defs/RepairEvent"
        }
      ]
    },
    "CreatedEvent": {
      "type": "object",
      "required": [
        "event_type",
        "payload"
      ],
      "properties": {
        "event_type": {
          "const": "workset.created"
        },
        "payload": {
          "$ref": "#/$defs/CreatedPayload"
        }
      },
      "additionalProperties": true
    },
    "DefinitionEvent": {
      "type": "object",
      "required": [
        "event_type",
        "payload"
      ],
      "properties": {
        "event_type": {
          "enum": [
            "workset.definition_revised",
            "workset.activated"
          ]
        },
        "payload": {
          "$ref": "#/$defs/DefinitionPayload"
        }
      },
      "additionalProperties": true
    },
    "ProviderEvent": {
      "type": "object",
      "required": [
        "event_type",
        "payload"
      ],
      "properties": {
        "event_type": {
          "enum": [
            "workset.provider_bound",
            "workset.provider_reconciled",
            "workset.provider_stale",
            "workset.provider_cursor_expired"
          ]
        },
        "payload": {
          "$ref": "#/$defs/ProviderPayload"
        }
      },
      "additionalProperties": true
    },
    "TombstoneEvent": {
      "type": "object",
      "required": [
        "event_type",
        "payload"
      ],
      "properties": {
        "event_type": {
          "const": "workset.provider_tombstone_observed"
        },
        "payload": {
          "$ref": "#/$defs/TombstonePayload"
        }
      },
      "additionalProperties": true
    },
    "AdmissionPreviewEvent": {
      "type": "object",
      "required": [
        "event_type",
        "payload"
      ],
      "properties": {
        "event_type": {
          "const": "workset.member_admission_previewed"
        },
        "payload": {
          "$ref": "#/$defs/AdmissionPreviewPayload"
        }
      },
      "additionalProperties": true
    },
    "AdmissionResultEvent": {
      "type": "object",
      "required": [
        "event_type",
        "payload"
      ],
      "properties": {
        "event_type": {
          "enum": [
            "workset.member_admission_rejected",
            "workset.member_admitted"
          ]
        },
        "payload": {
          "$ref": "#/$defs/AdmissionResultPayload"
        }
      },
      "additionalProperties": true
    },
    "MemberEvent": {
      "type": "object",
      "required": [
        "event_type",
        "payload"
      ],
      "properties": {
        "event_type": {
          "enum": [
            "workset.member_projection_changed",
            "workset.member_excluded",
            "workset.member_superseded"
          ]
        },
        "payload": {
          "$ref": "#/$defs/MemberPayload"
        }
      },
      "additionalProperties": true
    },
    "RelationshipEvent": {
      "type": "object",
      "required": [
        "event_type",
        "payload"
      ],
      "properties": {
        "event_type": {
          "enum": [
            "workset.relationship_added",
            "workset.relationship_removed"
          ]
        },
        "payload": {
          "$ref": "#/$defs/RelationshipPayload"
        }
      },
      "additionalProperties": true
    },
    "ExternalDependencyEvent": {
      "type": "object",
      "required": [
        "event_type",
        "payload"
      ],
      "properties": {
        "event_type": {
          "enum": [
            "workset.external_dependency_added",
            "workset.external_dependency_resolved"
          ]
        },
        "payload": {
          "$ref": "#/$defs/ExternalDependencyPayload"
        }
      },
      "additionalProperties": true
    },
    "EdgeEvent": {
      "type": "object",
      "required": [
        "event_type",
        "payload"
      ],
      "properties": {
        "event_type": {
          "enum": [
            "workset.edge_added",
            "workset.edge_removed"
          ]
        },
        "payload": {
          "$ref": "#/$defs/EdgePayload"
        }
      },
      "additionalProperties": true
    },
    "EpochEvent": {
      "type": "object",
      "required": [
        "event_type",
        "payload"
      ],
      "properties": {
        "event_type": {
          "enum": [
            "workset.epoch_opened",
            "workset.epoch_sealing",
            "workset.epoch_sealed"
          ]
        },
        "payload": {
          "$ref": "#/$defs/EpochPayload"
        }
      },
      "additionalProperties": true
    },
    "SealEvent": {
      "type": "object",
      "required": [
        "event_type",
        "payload"
      ],
      "properties": {
        "event_type": {
          "enum": [
            "workset.sealing_started",
            "workset.sealed",
            "workset.reopened"
          ]
        },
        "payload": {
          "$ref": "#/$defs/SealPayload"
        }
      },
      "additionalProperties": true
    },
    "CheckpointEvent": {
      "type": "object",
      "required": [
        "event_type",
        "payload"
      ],
      "properties": {
        "event_type": {
          "enum": [
            "workset.checkpoint_defined",
            "workset.checkpoint_started",
            "workset.checkpoint_passed",
            "workset.checkpoint_failed",
            "workset.checkpoint_indeterminate"
          ]
        },
        "payload": {
          "$ref": "#/$defs/CheckpointPayload"
        }
      },
      "additionalProperties": true
    },
    "WorkpointProposalEvent": {
      "type": "object",
      "required": [
        "event_type",
        "payload"
      ],
      "properties": {
        "event_type": {
          "const": "workset.workpoint_proposed"
        },
        "payload": {
          "$ref": "#/$defs/WorkpointProposalPayload"
        }
      },
      "additionalProperties": true
    },
    "CompletionEvent": {
      "type": "object",
      "required": [
        "event_type",
        "payload"
      ],
      "properties": {
