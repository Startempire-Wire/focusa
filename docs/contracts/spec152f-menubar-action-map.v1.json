  "invariants": [
    "buttons never mint or reinterpret entitlement",
    "commercial decisions live in canonical resolver, not presenters",
    "presenter click handlers inherit policy; they do not own it",
    "protected denial remains actionable with recovery paths",
    "navigation/display actions require no entitlement check",
    "recovery/account actions follow account_recovery family policy",
    "canonical_operation actions inherit the invoked operation's family policy",
    "no raw keys, tokens, or customer PII in action map"
  ],
  "accessibility_fixtures": {
    "schema": "focusa.spec152f.menubar_action_map_accessibility.v1",
    "always_reachable": [
      "navigation",
      "status",
      "account",
      "read",
      "export",
      "recovery",
      "repair",
      "update",
      "uninstall"
    ],
    "rules": [
      "no disabled control traps the customer away from data or purchase",
      "denied value actions carry an accessible explanation and an Evaluation/purchase/recovery action",
      "navigation, status, account, read, export, recovery, repair, update, and uninstall are never disabled by an entitlement decision",
      "presenters inherit the canonical decision; they never own component-local commercial policy"
    ]
  },
  "action_classes": {
    "navigation_display": {
      "description": "UI state changes, tab switching, copy-to-clipboard, modal open/close, zoom reset. No daemon call; no entitlement check.",
      "policy": "no_entitlement_check_required",
      "presenter_must_not": ["evaluate_entitlement", "reject_before_daemon_call", "mint_grants", "interpret_policy", "price_operation"]
    },
    "recovery_account": {
      "description": "License/entitlement status refresh, connection management, pairing lifecycle, update operations, debug bundle copy. Always reachable per account_recovery family.",
      "policy_family": "account_recovery",
      "policy": "always_available_subject_to_security",
      "presenter_must_not": ["evaluate_entitlement", "reject_before_daemon_call", "mint_grants", "interpret_policy"]
    },
    "canonical_operation": {
      "description": "Invokes a Focusa daemon operation with side effects. Policy inherited from the canonical operation's registered family.",
      "policy": "inherit_canonical_operation",
      "presenter_must_not": ["evaluate_entitlement", "reject_before_daemon_call", "mint_grants", "interpret_policy", "price_operation"],
      "presenter_must": ["forward_daemon_error_transparently", "preserve_recovery_paths"]
    }
  },
