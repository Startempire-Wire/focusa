[Unit]
Description=Focusa pair-once private communications connector
After=network-online.target
Wants=network-online.target
ConditionPathExists=@ENV_FILE@
ConditionPathExists=@CHECKPOINT_CREDENTIAL_FILE@
ConditionPathExists=@TOKEN_CREDENTIAL_FILE@
ConditionPathExists=@GRANTS_CREDENTIAL_FILE@
ConditionPathExists=@TARGETS_CREDENTIAL_FILE@
ConditionPathExists=@POLICY_CREDENTIAL_FILE@

[Service]
Type=notify
User=@RUNTIME_USER@
Group=@RUNTIME_GROUP@
UMask=0077
EnvironmentFile=@ENV_FILE@
Environment=FOCUSA_SMS_STATE_DIR=@STATE_DIR@
Environment=FOCUSA_SMS_RUNTIME_DIR=@RUNTIME_DIR@
Environment=FOCUSA_SMS_CHECKPOINT_KEY_FILE=%d/sms-checkpoint-key
Environment=FOCUSA_SMS_PROVIDER_POLICY_FILE=%d/sms-provider-policy
LoadCredentialEncrypted=sms-checkpoint-key:@CHECKPOINT_CREDENTIAL_FILE@
LoadCredentialEncrypted=sms-broker-token:@TOKEN_CREDENTIAL_FILE@
LoadCredentialEncrypted=sms-grants:@GRANTS_CREDENTIAL_FILE@
LoadCredentialEncrypted=sms-targets:@TARGETS_CREDENTIAL_FILE@
LoadCredentialEncrypted=sms-provider-policy:@POLICY_CREDENTIAL_FILE@
ExecStart=@INSTALL_ROOT@/libexec/focusa/focusa-sms-supervisor.py
Restart=always
RestartSec=2s
WatchdogSec=30s
TimeoutStartSec=90s
TimeoutStopSec=60s
KillMode=mixed
RuntimeDirectory=focusa-sms-broker
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
StateDirectory=focusa-sms-broker
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=@STATE_DIR@ @RUNTIME_DIR@

[Install]
WantedBy=multi-user.target
