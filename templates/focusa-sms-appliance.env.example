# Copy to /etc/focusa/sms-appliance.env as root, replace every @...@ token,
# and chmod 0600. No credential values belong in this file.
FOCUSA_SMS_REQUIRE_TMPFS=1
FOCUSA_SMS_ACTIVE_CDP_PORT=9334
FOCUSA_SMS_STANDBY_CDP_PORT=9335
FOCUSA_SMS_CHECKPOINT_INTERVAL_SECONDS=300
FOCUSA_SMS_PROBE_WINDOW_SECONDS=45
FOCUSA_SMS_BROWSER_COMMAND_JSON=["@CHROMIUM@","--user-data-dir={profile}","--remote-debugging-port={cdp_port}","--no-first-run","--disable-sync","https://messages.google.com/web/conversations"]
FOCUSA_SMS_READY_PROBE_COMMAND_JSON=["@NODE@","@INSTALL_ROOT@/libexec/focusa/focusa-sms-ready-probe.mjs","http://127.0.0.1:{cdp_port}"]
FOCUSA_SMS_BROKER_COMMAND_JSON=["/usr/bin/env","FOCUSA_SMS_CDP_PORT={cdp_port}","@PYTHON@","@INSTALL_ROOT@/libexec/focusa/focusa-google-messages-broker.py"]
