  "polling": {
    "binding": [
      "registration_id",
      "facade_id",
      "action",
      "expiry"
    ],
    "credential": "opaque_poll_credential",
    "default_retry_after_seconds": 3,
    "maximum_retry_after_seconds": 30,
    "response": "bounded_state_snapshot",
    "retry_rules": {
      "do_not_retry_unchanged": [
        "ACCOUNT_EMAIL_MISMATCH",
        "FACADE_ORIGIN_DENIED",
        "FACADE_PRODUCT_DENIED",
        "PRODUCT_MAPPING_REQUIRED",
        "EVALUATION_NOT_ELIGIBLE",
        "LICENSE_ACCOUNT_MISMATCH",
        "NODE_LIMIT_EXHAUSTED"
      ],
      "recovery_only": [
        "EDD_LICENSE_UNUSABLE",
        "REFUNDED",
        "REVOKED"
      ],
      "restart_verification": [
        "EMAIL_VERIFICATION_EXPIRED"
      ],
      "retry_with_same_idempotency_key": [
        "REQUEST_IN_PROGRESS"
      ],
      "safe_retry": [
        "EDD_ORDER_PENDING",
        "EDD_LICENSE_PENDING",
        "LICENSE_DELIVERY_PENDING",
        "AUTHORITY_UNAVAILABLE"
      ]
    },
    "stored_as": "keyed_hash_only",
    "terminal_states": [
      "activated",
      "denied",
      "recovery_only"
    ]
  },
