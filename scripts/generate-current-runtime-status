#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="$ROOT_DIR/docs/current/CURRENT_RUNTIME_STATUS.md"
VERSION=$(grep -m1 '^version = ' "$ROOT_DIR/Cargo.toml" | sed -E 's/version = "([^"]+)"/\1/')
TOOL_COUNT=$(jq -r '.tool_count' "$ROOT_DIR/docs/current/focusa-tool-contracts.json")
SUMMARY_REF='generated/tool-surface-summary.md'
SKILL_COUNT=$(jq -r '.skills | length' "$ROOT_DIR/config/agent-skills-v2.json")
STAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)
{
  echo '# Current Runtime Status'
  echo
  echo '<!-- GENERATED: scripts/generate-current-runtime-status. Do not edit by hand. -->'
  echo
  echo "Generated: ${STAMP}"
  echo "Source workspace version: ${VERSION}"
  echo 'Installed daemon/CLI version and current-process activation: not established by this generator.'
  echo "Tool contracts: ${TOOL_COUNT}"
  echo "Tool surface summary: [${SUMMARY_REF}](${SUMMARY_REF})"
  echo
  echo '## Source capability inventory (not installed or shipped proof)'
  echo
  echo 'Shared journey: [cohesive project flow](../agent/02-focusa-cohesive-project-flow.md). Discover current installed schemas/health/bindings and verify consumer outcomes separately; source inventory and generation do not grant execution or establish release completion.'
  echo
  echo '- typed project identity, Project Card, conditional Bootstrap/Genesis, Trajectory, Workpoint, evidence and recovery are source-defined capabilities; exact Scope/Workstream/continuity/attachment and current operation admission must be resolved through installed bindings.'
  echo '- Context Cognition builds bounded project context, curation, proof, and optimization packets without overriding Workpoint or operator steering.'
  echo '- prediction authority, temporal authority, metacognition, work-loop health, and Spec97 reflex suggestions provide evidence-backed routing and learning.'
  echo '- UIAI/WebMCP capability intake, browser workflow planning, preload packets, Silent Sessions, device pairing, and progressive Tool Discovery are cross-harness surfaces.'
  echo "- source contracts, declared Pi/MCP/OpenAI/CLI/REST projections, per-tool docs, Agent Card and ${SKILL_COUNT} registry skills are freshness/parity-gated; these checks do not prove connected-harness or installed behavior."
  echo
  echo '## Release invariant inputs'
  echo
  echo '- release stamp: docs/current/.release-version-stamp'
  echo '- version consistency: scripts/verify-doc-version-consistency'
  echo '- tool contracts: docs/current/focusa-tool-contracts.json'
  echo '- proof command: focusa release prove --tag <tag>'
} > "$OUT"
echo "wrote $OUT"
