#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
api_version=$(grep -m1 '^version = ' "$ROOT_DIR/Cargo.toml" | sed -E 's/version = "([^"]+)"/\1/')
core_version="$api_version"
cli_version="$api_version"
menubar_version=$(node -e "const p=require('$ROOT_DIR/apps/menubar/package.json'); process.stdout.write(p.version || '')")
stamp_file="$ROOT_DIR/docs/current/.release-version-stamp"
stamp_version=""
[[ -f "$stamp_file" ]] && stamp_version=$(tr -d '\n' < "$stamp_file")
if [[ "$api_version" != "$core_version" || "$api_version" != "$cli_version" || "$api_version" != "$menubar_version" ]]; then
  echo "version mismatch: api=$api_version core=$core_version cli=$cli_version menubar=$menubar_version" >&2
  exit 1
fi
if [[ -n "$stamp_version" && "$stamp_version" != "$api_version" ]]; then
  echo "release stamp mismatch: stamp=$stamp_version version=$api_version" >&2
  exit 1
fi
echo "version consistency ok: $api_version"
