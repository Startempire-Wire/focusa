#!/usr/bin/env python3
import hashlib, json, os
from pathlib import Path

root = Path(__file__).resolve().parents[1]
canonical = root / ".pi/skills"
targets = [Path.home() / ".pi/skills", Path.home() / ".pi/agent/skills"]

def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()

canonical_skills = {p.parent.name: p for p in canonical.glob("*/SKILL.md")}
findings = []
for target in targets:
    installed = {p.parent.name: p for p in target.glob("*/SKILL.md")} if target.is_dir() else {}
    for name, source in canonical_skills.items():
        candidate = installed.get(name)
        if not candidate:
            findings.append({"status":"missing","skill":name,"target":str(target)})
        elif digest(candidate) != digest(source):
            findings.append({
                "status":"stale_or_conflicting","skill":name,"target":str(candidate),
                "canonical_digest":digest(source),"installed_digest":digest(candidate)
            })
    for name, candidate in installed.items():
        if name.startswith("focusa") and name not in canonical_skills:
            findings.append({"status":"orphaned","skill":name,"target":str(candidate)})
shadowed = sorted({f["skill"] for f in findings if f["status"] == "stale_or_conflicting"})
payload = {
    "schema":"focusa.skill_doctor.v1",
    "canonical_root":str(canonical),
    "canonical_count":len(canonical_skills),
    "status":"healthy" if not findings else "degraded",
    "shadowed":shadowed,
    "findings":findings,
    "recovery":"Synchronize from the signed focusa-agent-context release asset; retire orphaned Focusa skills only after backup.",
}
print(json.dumps(payload, indent=2))
raise SystemExit(0 if not findings else 2)
